generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  password      String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  caseType      String?
  dob           DateTime?
  firstName     String?
  lastName      String?
  salutation    String?
  uniqueUserId  String?      @unique
  accounts      Account[]
  intakes       IntakeInfo[]
  sessions      Session[]
  formSubmissions FormSubmission[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model IntakeInfo {
  id                           String         @id @default(cuid())
  userId                       String?
  clientName                   String
  gender                       String?
  phoneNumber                  String?
  email                        String?
  address                      String?
  city                         String?
  zip                          String?
  dateOfBirth                  DateTime?
  ssn                          String?
  accidentDate                 DateTime?
  accidentTime                 String?
  accidentLocation             String?
  accidentDescription          String?
  passenger                    String?
  passengerName                String?
  workAtAccident               String?
  defendant1Name               String?
  defendant1Address            String?
  defendant1Carrier            String?
  defendant1CarrierPhone       String?
  defendant1Year               String?
  defendant1Make               String?
  defendant1Model              String?
  defendant1Damage             String?
  defendant2Name               String?
  defendant2Address            String?
  defendant2Carrier            String?
  defendant2CarrierPhone       String?
  defendant2Year               String?
  defendant2Make               String?
  defendant2Model              String?
  defendant2Damage             String?
  autoName                     String?
  autoPhone                    String?
  autoAddress                  String?
  autoAgent                    String?
  autoPolicy                   String?
  autoClaim                    String?
  autoAdditionalinfo           String?
  healthCarrier                String?
  healthPhone                  String?
  healthAddress                String?
  healthPolicy                 String?
  healthClaim                  String?
  healthAdjuster               String?
  healthAgent                  String?
  healthAdditionalinfo         String?
  medicare                     String?
  medicareNumber               String?
  medicaid                     String?
  medicaidNumber               String?
  ambulance                    String?
  ambulanceCompany             String?
  admitted                     String?
  lengthOfStay                 String?
  bodyPartsAffected            String?
  priorInjuries                String?
  priorDoctorHospital          String?
  priorHospitalAddressPhone    String?
  priorTreatmentDetails        String?
  priorTreatmentFrom           DateTime?
  priorTreatmentTo             DateTime?
  priorInsuranceClaims         String?
  priorAttorneys               String?
  currentTreatment             String?
  currentDoctorHospital        String?
  currentHospitalAddressPhone  String?
  currentTreatmentDetails      String?
  currentTreatmentFrom         DateTime?
  currentTreatmentTo           DateTime?
  hearAboutUs                  String?
  hearAboutUsDetail            String?
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt
  isDraft                      Boolean        @default(true)
  referenceId                  String?
  currentDoctorHospital2       String?
  currentDoctorHospital3       String?
  currentHospitalAddressPhone2 String?
  currentHospitalAddressPhone3 String?
  currentTreatmentDetails2     String?
  currentTreatmentDetails3     String?
  currentTreatmentFrom2        DateTime?
  currentTreatmentFrom3        DateTime?
  currentTreatmentTo2          DateTime?
  currentTreatmentTo3          DateTime?
  defendant3Address            String?
  defendant3Carrier            String?
  defendant3CarrierPhone       String?
  defendant3Damage             String?
  defendant3Make               String?
  defendant3Model              String?
  defendant3Name               String?
  defendant3Year               String?
  hospitalName                 String?
  hospitalized                 String?
  injuryDescription            String?
  passengerAge                 String?
  priorAttorneys2              String?
  priorAttorneys3              String?
  priorDoctorHospital2         String?
  priorDoctorHospital3         String?
  priorHospitalAddressPhone2   String?
  priorHospitalAddressPhone3   String?
  priorInsuranceClaims2        String?
  priorInsuranceClaims3        String?
  priorTreatmentDetails2       String?
  priorTreatmentDetails3       String?
  priorTreatmentFrom2          DateTime?
  priorTreatmentFrom3          DateTime?
  priorTreatmentTo2            DateTime?
  priorTreatmentTo3            DateTime?
  relationshipToYou            String?
  seatbeltUsed                 String?
  treatmentDetails             String?
  user                         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  Document Document[]
  LeadId String? @unique
  Lead   Lead? @relation(fields: [LeadId], references: [id])

}

model Lead {
  id            String   @id @default(cuid())
  dueDate       DateTime
  name          String
  caseType      String
  status        String   @default("new")
  contact       String
  phone         String
  email         String
  matter        String   @default("-")
  description   String?
  referralSource String?
  referenceId   String?  @unique
  dateOfBirth   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  intakeInfo  IntakeInfo?
}

model Document {
  id          String      @id @default(cuid())
  intakeId    String
  fileName    String
  filePath    String
  mimeType    String?
  uploadedAt  DateTime    @default(now())
  intake      IntakeInfo  @relation(fields: [intakeId], references: [id], onDelete: Cascade)

model IntakeInfo {
  id     String @id @default(cuid())

  intakeSessionId String? @unique
  intakeSession   IntakeSession? @relation(fields: [intakeSessionId], references: [id])
  userId String? // foreign key linking to User

  // 👤 Plaintiff Information
  clientName  String
  gender      String?
  phoneNumber String?
  email       String?
  address     String?
  city        String?
  zip         String?
  dateOfBirth DateTime?
  ssn         String?

  // 🚗 Accident Information
  accidentDate        DateTime?
  accidentTime        String?
  accidentLocation    String?
  accidentDescription String?
  passenger           String?
  passengerName       String?
  workAtAccident      String?

  // Defendant 1 / Driver
  defendant1Name         String?

  defendant1Address      String?
  defendant1Carrier      String?
  defendant1CarrierPhone String?

  defendant1Year         String?
  defendant1Make         String?
  defendant1Model        String?
  defendant1Damage       String?

  // Defendant 2 / Owner
  defendant2Name         String?

  defendant2Address      String?
  defendant2Carrier      String?
  defendant2CarrierPhone String?

  defendant2Year         String?
  defendant2Make         String?
  defendant2Model        String?
  defendant2Damage       String?

  // Client Automobile Insurance
  autoName     String?
  autoPhone    String?
  autoAddress  String?

  autoAgent    String?
  autoPolicy   String?
  autoClaim    String?
  autoAdditionalinfo    String?


  // Client Health Insurance
  healthCarrier String?
  healthPhone   String?

  healthAddress String?

  healthPolicy  String?
  healthClaim   String?
  healthAdjuster String?
  healthAgent String?
  healthAdditionalinfo String?

  medicare       String? // "Yes" / "No"
  medicareNumber String?
  medicaid       String? // "Yes" / "No"
  medicaidNumber String?

  // Medical Treatment
  ambulance        String? // "Yes" / "No"
  ambulanceCompany String?
  admitted         String? // "Yes" / "No"
  lengthOfStay     String?

  doctorHospital1 String?
  address1        String?
  phone1          String?
  treatmentDate1  DateTime?

  doctorHospital2 String?
  address2        String?
  phone2          String?
  treatmentDate2  DateTime?


  // Injuries
  bodyPartsAffected    String?
  priorInjuries        String?
  priorDoctorHospital        String?
  priorHospitalAddressPhone        String?
  priorTreatmentDetails        String?
  priorTreatmentFrom        DateTime?
  priorTreatmentTo        DateTime?
  priorInsuranceClaims String?
  priorAttorneys       String?


  currentTreatment           String?
  currentDoctorHospital      String?
  currentHospitalAddressPhone String?
  currentTreatmentDetails    String?
  currentTreatmentFrom       DateTime?
  currentTreatmentTo         DateTime?
  hearAboutUs                String?
  hearAboutUsDetail          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referenceId                String?
  isDraft                    Boolean @default(true)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Matter {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("Open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  formSubmissions FormSubmission[]
}

model FormTemplate {
  id        String   @id @default(cuid())
  title     String
  language  String   @default("English")
  fields    Json
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions FormSubmission[]
}

model FormSubmission {
  id         String   @id @default(cuid())
  templateId String
  userId     String?
  matterId   String?
  status     String   @default("Pending")
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template FormTemplate @relation(fields: [templateId], references: [id])
  user     User?        @relation(fields: [userId], references: [id])
  matter   Matter?      @relation(fields: [matterId], references: [id])
}
