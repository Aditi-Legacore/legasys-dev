generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  password      String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  accounts      Account[]
  sessions      Session[]
  intakes       IntakeInfo[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model IntakeInfo {
  id     String @id @default(cuid())
  userId String? // foreign key linking to User

  // 👤 Plaintiff Information
  clientName  String
  gender      String?
  phoneNumber String?
  email       String?
  address     String?
  city        String?
  zip         String?
  dateOfBirth DateTime?
  ssn         String?

  // 🚗 Accident Information
  accidentDate        DateTime?
  accidentTime        String?
  accidentLocation    String?
  accidentDescription String?
  passenger           String?
  passengerName       String?
  workAtAccident      String?
  // caseType            String?
  // policeCase          String?
  // seatBelt            String?
  // seatBeltReason      String?

  // Defendant 1 / Driver
  defendant1Name         String?
  // defendant1Phone        String?
  defendant1Address      String?
  defendant1Carrier      String?
  defendant1CarrierPhone String?
  // defendant1Policy       String?
  // defendant1Claim        String?
  // defendant1Adjuster     String?
  // defendant1Insured      String?
  defendant1Year         String?
  defendant1Make         String?
  defendant1Model        String?
  defendant1Damage       String?

  // Defendant 2 / Owner
  defendant2Name         String?
  // defendant2Phone        String?
  defendant2Address      String?
  defendant2Carrier      String?
  defendant2CarrierPhone String?
  // defendant2Policy       String?
  // defendant2Claim        String?
  // defendant2Adjuster     String?
  // defendant2Insured      String?
  defendant2Year         String?
  defendant2Make         String?
  defendant2Model        String?
  defendant2Damage       String?

  // Client Automobile Insurance
  autoName     String?
  autoPhone    String?
  autoAddress  String?
  // autoCarrier  String?
  autoAgent    String?
  autoPolicy   String?
  autoClaim    String?
  autoAdditionalinfo    String?
  // autoAdjuster String?
  // autoInsured  String?

  // Client Health Insurance
  healthCarrier String?
  healthPhone   String?
  // healthType    String?
  healthAddress String?
  // healthGroup   String?
  healthPolicy  String?
  healthClaim   String?
  healthAdjuster String?
  healthAgent String?
  healthAdditionalinfo String?

  medicare       String? // "Yes" / "No"
  medicareNumber String?
  medicaid       String? // "Yes" / "No"
  medicaidNumber String?

  // Medical Treatment
  ambulance        String? // "Yes" / "No"
  ambulanceCompany String?
  admitted         String? // "Yes" / "No"
  lengthOfStay     String?

  doctorHospital1 String?
  address1        String?
  phone1          String?
  treatmentDate1  DateTime?

  doctorHospital2 String?
  address2        String?
  phone2          String?
  treatmentDate2  DateTime?

  // doctorHospital3 String?
  // address3        String?
  // phone3          String?
  // treatmentDate3  DateTime?

  // Injuries
  bodyPartsAffected    String?
  priorInjuries        String?
  priorDoctorHospital        String?
  priorHospitalAddressPhone        String?
  priorTreatmentDetails        String?
  priorTreatmentFrom        DateTime?
  priorTreatmentTo        DateTime?
  priorInsuranceClaims String?
  priorAttorneys       String?

  // Additional fields from form
  // priorDoctorHospital        String?
  // priorHospitalAddressPhone  String?
  // priorTreatmentDetails      String?
  // priorTreatmentFrom         DateTime?
  // priorTreatmentTo           DateTime?
  currentTreatment           String?
  currentDoctorHospital      String?
  currentHospitalAddressPhone String?
  currentTreatmentDetails    String?
  currentTreatmentFrom       DateTime?
  currentTreatmentTo         DateTime?
  hearAboutUs                String?
  hearAboutUsDetail          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}
