datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}



model User {
  id            String       @id @default(cuid())
  email         String       @unique
  password      String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  caseType      String?
  dob           DateTime?
  firstName     String?
  lastName      String?
  salutation    String?
  uniqueUserId  String?      @unique
  accounts      Account[]
  intakes       IntakeInfo[]
  sessions      Session[]
  formSubmissions FormSubmission[]
  notes         Note[]
  demandNotes DemandNote[]
  uploadedFiles DemandFile[]
  internalNotes DemandInternalNote[]
  statusHistories DemandStatusHistory[]
  jobs          Job[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model IntakeInfo {
  id                           String         @id @default(cuid())
  userId                       String?
  clientName                   String
  gender                       String?
  phoneNumber                  String?
  email                        String?
  address                      String?
  city                         String?
  zip                          String?
  dateOfBirth                  DateTime?
  ssn                          String?
  accidentDate                 DateTime?
  accidentTime                 String?
  accidentLocation             String?
  accidentDescription          String?
  passenger                    String?
  passengerName                String?
  workAtAccident               String?
  defendant1Name               String?
  defendant1Address            String?
  defendant1Carrier            String?
  defendant1CarrierPhone       String?
  defendant1Year               String?
  defendant1Make               String?
  defendant1Model              String?
  defendant1Damage             String?
  defendant2Name               String?
  defendant2Address            String?
  defendant2Carrier            String?
  defendant2CarrierPhone       String?
  defendant2Year               String?
  defendant2Make               String?
  defendant2Model              String?
  defendant2Damage             String?
  autoName                     String?
  autoPhone                    String?
  autoAddress                  String?
  autoAgent                    String?
  autoPolicy                   String?
  autoClaim                    String?
  autoAdditionalinfo           String?
  healthCarrier                String?
  healthPhone                  String?
  healthAddress                String?
  healthPolicy                 String?
  healthClaim                  String?
  healthAdjuster               String?
  healthAgent                  String?
  healthAdditionalinfo         String?
  medicare                     String?
  medicareNumber               String?
  medicaid                     String?
  medicaidNumber               String?
  ambulance                    String?
  ambulanceCompany             String?
  admitted                     String?
  lengthOfStay                 String?
  bodyPartsAffected            String?
  priorInjuries                String?
  priorDoctorHospital          String?
  priorHospitalAddressPhone    String?
  priorTreatmentDetails        String?
  priorTreatmentFrom           DateTime?
  priorTreatmentTo             DateTime?
  priorInsuranceClaims         String?
  priorAttorneys               String?
  currentTreatment             String?
  currentDoctorHospital        String?
  currentHospitalAddressPhone  String?
  currentTreatmentDetails      String?
  currentTreatmentFrom         DateTime?
  currentTreatmentTo           DateTime?
  hearAboutUs                  String?
  hearAboutUsDetail            String?
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt
  isDraft                      Boolean        @default(true)
  referenceId                  String?
  currentDoctorHospital2       String?
  currentDoctorHospital3       String?
  currentHospitalAddressPhone2 String?
  currentHospitalAddressPhone3 String?
  currentTreatmentDetails2     String?
  currentTreatmentDetails3     String?
  currentTreatmentFrom2        DateTime?
  currentTreatmentFrom3        DateTime?
  currentTreatmentTo2          DateTime?
  currentTreatmentTo3          DateTime?
  defendant3Address            String?
  defendant3Carrier            String?
  defendant3CarrierPhone       String?
  defendant3Damage             String?
  defendant3Make               String?
  defendant3Model              String?
  defendant3Name               String?
  defendant3Year               String?
  hospitalName                 String?
  hospitalized                 String?
  injuryDescription            String?
  passengerAge                 String?
  priorAttorneys2              String?
  priorAttorneys3              String?
  priorDoctorHospital2         String?
  priorDoctorHospital3         String?
  priorHospitalAddressPhone2   String?
  priorHospitalAddressPhone3   String?
  priorInsuranceClaims2        String?
  priorInsuranceClaims3        String?
  priorTreatmentDetails2       String?
  priorTreatmentDetails3       String?
  priorTreatmentFrom2          DateTime?
  priorTreatmentFrom3          DateTime?
  priorTreatmentTo2            DateTime?
  priorTreatmentTo3            DateTime?
  relationshipToYou            String?
  seatbeltUsed                 String?
  treatmentDetails             String?
  user                         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  Document Document[]
  LeadId String? @unique
  Lead   Lead? @relation(fields: [LeadId], references: [id])

  // New models for notes and activity logs
  activityLogs                ActivityLog[]  @relation("IntakeToActivityLogs")
  Notes Note[]
}

model Lead {
  id            String   @id @default(cuid())
  dueDate       DateTime
  name          String
  caseType      String
  status        String   @default("new")
  contact       String
  phone         String
  email         String
  matter        String   @default("-")
  description   String?
  referralSource String?
  referenceId   String?  @unique
  dateOfBirth   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  intakeInfo  IntakeInfo?
}

model Document {
  id          String      @id @default(cuid())
  intakeId    String
  fileName    String
  filePath    String
  mimeType    String?
  uploadedAt  DateTime    @default(now())
  intake      IntakeInfo  @relation(fields: [intakeId], references: [id], onDelete: Cascade)
}

model Matter {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("Open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  formSubmissions FormSubmission[]
}

model FormTemplate {
  id        String   @id @default(cuid())
  title     String
  language  String   @default("English")
  fields    Json
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions FormSubmission[]
}

model FormSubmission {
  id         String   @id @default(cuid())
  templateId String
  userId     String?
  matterId   String?
  status     String   @default("Pending")
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template FormTemplate @relation(fields: [templateId], references: [id])
  user     User?        @relation(fields: [userId], references: [id])
  matter   Matter?      @relation(fields: [matterId], references: [id])
}

model Note {
  id         String   @id @default(cuid())
  intakeId   String
  content    String
  createdById String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  intake     IntakeInfo @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  createdBy  User      @relation(fields: [createdById], references: [id])
}

model ActivityLog {
  id              String   @id @default(uuid())
  intakeId         String
  activityType    String
  shortDescription String
  longDescription  String
  createdBy       String
  createdAt       DateTime @default(now())

  intake          IntakeInfo  @relation("IntakeToActivityLogs", fields: [intakeId], references: [id], onDelete: Cascade)
}

model OTP {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, otp])
}

model DemandNote {
  id             String       @id @default(cuid())
  clientId       String
  createdById    String
  title          String
  description    String?
  referenceNumber String?     @unique
  totalAmount    Float
  dueDate        DateTime?
  status         String       @default("draft") // draft | sent | overdue | paid
  priority       String?      // low | medium | high
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // relations  
  client         DefedantClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy      User         @relation(fields: [createdById], references: [id])

  files          DemandFile[]
  internalNotes  DemandInternalNote[]
  timeline       DemandTimeline[]
  statusHistory  DemandStatusHistory[]
  reminders      DemandReminder[]
  tags           DemandNoteTag[]
  jobs           Job[]
}

model DefedantClient {
  id         String       @id @default(cuid())
  name       String
  email      String?
  phone      String?
  address    String?
  gstNumber  String?
  panNumber  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  demandNotes DemandNote[]
}

// -----------------------------
// Files
// -----------------------------

model DemandFile {
  id           String      @id @default(cuid())
  demandNoteId String
  uploadedById String
  fileCategory String?
  fileName     String
  fileUrl      String
  fileType     String?
  size         Int?
  status       String      @default("uploaded")
  filePath     String?
  createdAt    DateTime    @default(now())

  demandNote   DemandNote  @relation(fields: [demandNoteId], references: [id], onDelete: Cascade)
  uploadedBy   User        @relation(fields: [uploadedById], references: [id])
  tasks        Task[]      // ✅ added (opposite of Task.demandFile)
}

model Job {
  id           String    @id @default(cuid())
  demandNoteId  String  @unique
  createdById  String
  status       String    @default("pending") // pending | in_progress | completed | failed
  numTasks     Int       @default(0)
  outputSummary   String?
  createTs     DateTime  @default(now())
  updateTs     DateTime  @updatedAt

  demandNote   DemandNote @relation(fields: [demandNoteId], references: [id], onDelete: Cascade)
  createdBy    User       @relation(fields: [createdById], references: [id])
  tasks        Task[]
}

model Task {
  id         String   @id @default(cuid())
  jobId      String
  demandFileId    String
  fileName   String
  outputFilePath String?
  filePath   String
  status     String   @default("pending") // pending | in_progress | completed | failed
  pid        Int?
  outputSummary String?
  startTs    DateTime?
  endTs      DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  demandFile      DemandFile? @relation(fields: [demandFileId], references: [id])
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// -----------------------------
// Internal Notes
// -----------------------------

model DemandInternalNote {
  id           String      @id @default(cuid())
  demandNoteId String
  createdById  String
  content      String
  createdAt    DateTime    @default(now())

  demandNote   DemandNote  @relation(fields: [demandNoteId], references: [id], onDelete: Cascade)
  createdBy    User        @relation(fields: [createdById], references: [id])
}

// -----------------------------
// Timeline
// -----------------------------

model DemandTimeline {
  id           String      @id @default(cuid())
  demandNoteId String
  type         String      // created | email-sent | status-updated | file-uploaded | note-added
  message      String
  metadata     Json?
  createdAt    DateTime    @default(now())

  demandNote   DemandNote  @relation(fields: [demandNoteId], references: [id], onDelete: Cascade)
}

// -----------------------------
// Status History
// -----------------------------

model DemandStatusHistory {
  id           String      @id @default(cuid())
  demandNoteId String
  changedById  String
  oldStatus    String?
  newStatus    String
  createdAt    DateTime    @default(now())

  demandNote   DemandNote  @relation(fields: [demandNoteId], references: [id], onDelete: Cascade)
  changedBy    User        @relation(fields: [changedById], references: [id])
}

// -----------------------------
// Reminders
// -----------------------------

model DemandReminder {
  id           String      @id @default(cuid())
  demandNoteId String
  remindAt     DateTime
  sent         Boolean     @default(false)
  type         String      // email | sms | whatsapp
  createdAt    DateTime    @default(now())

  demandNote   DemandNote  @relation(fields: [demandNoteId], references: [id], onDelete: Cascade)
}

// -----------------------------
// Tags + Pivot
// -----------------------------

model DemandTag {
  id        String        @id @default(cuid())
  name      String        @unique
  color     String?
  createdAt DateTime      @default(now())

  notes     DemandNoteTag[]
}

model DemandNoteTag {
  id           String      @id @default(cuid())
  demandNoteId String
  tagId        String

  demandNote   DemandNote  @relation(fields: [demandNoteId], references: [id], onDelete: Cascade)
  tag          DemandTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)
}
